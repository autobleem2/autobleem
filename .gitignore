.claude/settings.local.json
# anchored to the root: an unanchored "build/" also matches lib_ableem/third_party/libchdr/deps/zstd-1.5.6/build/,
# which is vendored *source* (zstd's own CMakeLists.txt lives there), not a build output directory - it was
# silently missing from every fresh clone until this line was anchored (2026-09-18).
/build/

# the mocked USB root tools/make_usb.py builds for running the app on a PC
usb/

# the PS1 BIOS images (System/Bios on the Pi) - never committed. payload/RetroArch/bios holds only the
# console's BIOS manifest (tools/biospack.py --arch psc) and a README, no BIOS file.
bios/
!/payload/RetroArch/bios/
/payload/RetroArch/bios/*
!/payload/RetroArch/bios/biospack.txt
!/payload/RetroArch/bios/README.txt
__pycache__/

# tools/win_drive.ps1's screenshots land in the root
/shot*.png

# the cover databases docker/build-image.sh stages into the image build context
/docker/db/

# the self-hosted runner's token (docker/runner/compose.yml)
/docker/runner/.env
/build_samples/
