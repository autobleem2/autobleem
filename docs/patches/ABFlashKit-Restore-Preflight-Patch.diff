         noBar();
+        if (!contents.hasBoot) {
+            ui_.status(_("Recovery interrupted: backup has no boot image"));
+            ui_.wait(3000);
+            return Outcome::Failed;
+        }
         if (contents.hasBoot) {
             PLOG_INFO << "backup: boot " << (contents.bootIsVanilla ? "vanilla" : "modified") << ", rootfs "
