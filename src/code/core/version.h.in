// Generated by cmake/generate_version.cmake at build time - do not edit, edit version.h.in.
#pragma once

namespace Version {

constexpr const char *VERSION = "@GIT_VERSION@";              // the last git tag, or the fallback CMakeLists names
constexpr const char *GIT_HASH = "@GIT_HASH@";                // short commit hash, "unknown" without git
// git describe: the tag at a tag ("v2.0.0-alpha2"), "v2.0.0-alpha2-6-gba7365c" between tags - the name the
// download site gives this build's release or nightly folder, what the update check compares
constexpr const char *DESCRIBE = "@GIT_DESCRIBE@";
constexpr const char *GIT_BRANCH = "@GIT_BRANCH@";
constexpr bool GIT_DIRTY = @GIT_DIRTY@;                       // uncommitted changes in the tree that was built
constexpr const char *GIT_DIRTY_FLAG = "@GIT_DIRTY_FLAG@";    // "*" when dirty
constexpr const char *BUILD_TIMESTAMP = "@BUILD_TIMESTAMP@";  // UTC

// "v2.0.0-pre0 (master@a83777b*)" - what the splash, the About screen and the log banner show
constexpr const char *FULL_VERSION = "@GIT_VERSION@ (@GIT_BRANCH@" "@" "@GIT_HASH@@GIT_DIRTY_FLAG@)";

// a pre-release build ("-pre", "-alpha", "-beta", "-rc" in the tag): the update channel defaults to
// "testing" on one (Config), the site's index lists it as a pre-release
inline bool isPreRelease() {
    const char *v = VERSION;
    static const char *const markers[] = {"-pre", "-alpha", "-beta", "-rc"};
    for (const char *marker : markers) {
        const char *at = v;
        while (*at) {
            const char *a = at, *m = marker;
            while (*a && *m && *a == *m) {
                a++;
                m++;
            }
            if (!*m)
                return true;
            at++;
        }
    }
    return false;
}

// a build between tags (git describe went past the last tag): a development build - the update channel
// defaults to "nightly" on one
inline bool isBetweenTags() {
    const char *a = DESCRIBE, *b = VERSION;
    while (*a && *a == *b) {
        a++;
        b++;
    }
    return *a != *b;
}

} // namespace Version
