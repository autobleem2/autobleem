# The PC test machine's sway (R24): the shell on $work, the status panel and the VM's live view on $panel.
# Installed as ~/.config/sway/config by tools/abpanel/install.sh; `swaymsg -t get_outputs` names the connectors
# (swap the two lines below to swap the monitors). With one monitor both workspaces are on it:
# Super+1 the shell, Super+2 the panel.
set $mod Mod4
set $work eDP-1
set $panel HDMI-A-1

font pango:monospace 10
default_border pixel 1
focus_follows_mouse no

workspace 1 output $work
workspace 2 output $panel $work

assign [app_id="^abpanel$"] workspace 2
assign [app_id="virt-viewer"] workspace 2

# the shell (tmux, so an ssh session can attach to the same one: tmux attach -t main)
exec foot --app-id work tmux new-session -A -s main
# the panel, then the VM beside it - a live view through libvirt (--attach: no network port of its own)
exec foot --app-id abpanel ~/.local/bin/abpanel
exec sh -c 'sleep 2; exec virt-viewer -c qemu:///system --attach --reconnect --wait pcusb-test'
exec sh -c 'sleep 3; swaymsg workspace 1'

bindsym $mod+Return exec foot
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+Shift+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exit
