+/* AutoBleem: with AB_FSCK_PROGRESS=FILE in the environment, FILE holds the check's progress in percent (one
+ * number, replaced whole by a rename): 2 at the start, 5 once the FAT is read, 5..95 while the files' clusters
+ * are walked (walked / used in the FAT), 95 after the walk. A console's boot screen draws its bar from it. */
+static const char *ab_progress_file;
+static uint32_t ab_progress_used, ab_progress_done;
+static int ab_progress_last = -1;
+
+void ab_progress_set(int percent)
+{
+    char tmp[4096];
+    FILE *f;
+
+    if (!ab_progress_file || percent == ab_progress_last)
+	return;
+    ab_progress_last = percent;
+    snprintf(tmp, sizeof(tmp), "%s.tmp", ab_progress_file);
+    f = fopen(tmp, "w");
+    if (!f)
+	return;
+    fprintf(f, "%d\n", percent);
+    fclose(f);
+    rename(tmp, ab_progress_file);
+}
+
+void ab_progress_start(DOS_FS * fs)
+{
+    uint32_t i;
+    FAT_ENTRY entry;
+
+    ab_progress_used = ab_progress_done = 0;
+    if (!ab_progress_file)
+	return;
+    for (i = 2; i < fs->data_clusters + 2; i++) {
+	get_fat(&entry, fs->fat, i, fs);
+	if (entry.value)
+	    ab_progress_used++;
+    }
+    ab_progress_set(5);
+}
+
+void ab_progress_tick(void)
+{
+    if (!ab_progress_file || !ab_progress_used)
+	return;
+    if (ab_progress_done < ab_progress_used)
+	ab_progress_done++;
+    ab_progress_set(5 + (int)((uint64_t)ab_progress_done * 90 / ab_progress_used));
+}
+
