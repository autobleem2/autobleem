#!/bin/sh
#
# A PE mod's "show this text" call - sdl_text_display TEXT [X Y SIZE FONT R G B BGIMAGE BGCOLOR] - which does not wait.
# Its interface is the 2020 tool's (src/tools/abdialog/dialog_cmd.h has it): the arguments go into a command file as
# records, and sdl_display - started once per run, left running - shows the texts as AutoBleem's own screen in the
# current theme until the mod's own `killall sdl_display` (or kill) ends it. A second call rewrites the file and the
# screen follows. The position, size, font, colour and picture are the 2020 screen's and are not used.
# Without the program (no Autobleem/bin/autobleem/abdialog on the stick) the sdl_display next to this script is the
# stand-in that shows nothing and just stays; with no display the program itself does the same. Always succeeds.
# Exit 1 with no text, as the original did.
if [ -z "$1" ]; then
    echo "usage: $0 <TEXT> <TEXTX> <TEXTY> <FONTSIZE> <FONT> <R> <G> <B> <BGIMAGEPATH> <TEXTBGCOLOR (0xAARRGGBB)> &" >&2
    exit 1
fi
RUN_DIR=${PE_RUN_DIR:-/tmp/pe}
mkdir -p "$RUN_DIR" 2>/dev/null
LOG=${PE_DIALOG_LOG:-$RUN_DIR/dialogs.log}
echo "sdl_text_display: $1" >> "$LOG" 2>/dev/null

# the command file, written whole and moved into place (the screen reads it when its stamp changes)
CMD=$RUN_DIR/sdldisplaycmd
{
    printf 'IMAGE\t640\t360\t%s\n' "$9"
    if [ -z "${10}" ]; then
        printf 'FTEXT\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "${2:-640}" "${3:-120}" "${4:-12}" "$5" "${6:-255}" "${7:-255}" "${8:-255}" "$1"
    else
        printf 'FTEXTWBG\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "${2:-640}" "${3:-120}" "${4:-12}" "$5" "${6:-255}" "${7:-255}" "${8:-255}" "${10}" "$1"
    fi
} > "$CMD.new" 2>/dev/null && mv -f "$CMD.new" "$CMD"

HERE=$(cd "$(dirname "$0")" && pwd)
if [ -x "$HERE/sdl_display" ]; then
    PIDFILE="$RUN_DIR/sdl_display.pid"
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        exit 0
    fi
    # the program finds the launcher's SDL family where the console keeps it, and never the launcher's debug port
    if [ -d "${PE_SDL_DIR:-/tmp/lib}" ]; then
        LD_LIBRARY_PATH="${PE_SDL_DIR:-/tmp/lib}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
        export LD_LIBRARY_PATH
    fi
    unset AB_DEBUG_PORT
    if [ -n "$AB_DIALOG_DEBUG_PORT" ]; then
        AB_DEBUG_PORT=$AB_DIALOG_DEBUG_PORT
        export AB_DEBUG_PORT
    fi
    "$HERE/sdl_display" -file "$CMD" > "$(dirname "$LOG")/abdialog.log" 2>&1 < /dev/null &
    echo $! > "$PIDFILE"
fi
exit 0
