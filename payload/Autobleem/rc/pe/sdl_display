#!/bin/sh
#
# The process a PE mod's script stops with "killall sdl_display" (or kill $PID) when it is done with a message on
# screen. This is the stand-in: pe_env.sh puts it in the mod's bin/ only where the real text screen (abdialog, linked
# there under this name) is not on the stick. It draws nothing - it is the process sdl_text_display starts so the mod
# has one to stop - and ends when it is told to. Its options (-file ...) are ignored.
trap 'kill $PE_SLEEP 2>/dev/null; exit 0' TERM INT HUP
sleep 86400 &
PE_SLEEP=$!
wait $PE_SLEEP
