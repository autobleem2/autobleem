[Unit]
Description=AutoBleem launcher
# the launcher is useless before its games partition is there, and it owns tty1 instead of a login prompt
RequiresMountsFor=@DATA_MOUNT@
After=systemd-user-sessions.service sound.target plymouth-start.service plymouth-quit.service
# plymouth-quit.service would take the boot splash down (and put the text console back) as soon as the
# system is up, a second or two before the launcher has the display. Keeping it out of the boot lets
# autobleem-session quit plymouth itself, right before starting the launcher and with the logo left on
# screen - the same arrangement a display manager uses. Without plymouth installed this is a no-op.
Conflicts=getty@tty1.service plymouth-quit.service

[Service]
Type=simple
ExecStart=/usr/local/bin/autobleem-session @DATA_MOUNT@
# /run/autobleem (tmpfs) for this run's logs and hand-over files - the data partition is written only when
# the user's state changes (docs/quiet-stick-plan.md); the session exports it as AB_RUNTIME_DIR
RuntimeDirectory=autobleem
WorkingDirectory=@DATA_MOUNT@/Autobleem/bin/autobleem

# tty1 is the launcher's screen and its keyboard. TTYVHangup clears whatever held the terminal before us.
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

# Raspberry Pi OS Lite has no X and no compositor, so SDL2 draws straight to the KMS/DRM device. Saying so
# explicitly stops SDL probing (and picking the dummy driver when a probe misfires).
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=SDL_AUDIODRIVER=alsa

# libretro's buildbot cores (pcsx_rearmed's dynarec among them) are marked as needing an executable stack,
# and glibc 2.41 (Trixie) refuses to dlopen such a library: "cannot enable executable stack as shared
# object requires". This tunable lets it; every program the session starts inherits it.
Environment=GLIBC_TUNABLES=glibc.rtld.execstack=2

# a crash should put the launcher back on screen, not drop the user on a black tty
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
